<Window x:Class="BlacksmithStore.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Blacksmith Store" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BgMainBrush}">
    <Grid>
        <materialDesign:Card Background="{DynamicResource BgCardBrush}" Padding="30" Margin="30" VerticalAlignment="Center">
            <StackPanel>
                <materialDesign:PackIcon Kind="AccountLock" Width="60" Height="60" Foreground="{StaticResource MainGoldBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{DynamicResource txtLoginTitle}" Foreground="{DynamicResource TextMainBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBox x:Name="txtUsername" materialDesign:HintAssist.Hint="{DynamicResource txtLogin}" Foreground="{DynamicResource TextMainBrush}" Margin="0,10" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16"/>
                <PasswordBox x:Name="txtPassword" materialDesign:HintAssist.Hint="{DynamicResource txtPassword}" Foreground="{DynamicResource TextMainBrush}" Margin="0,10,0,30" Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}" FontSize="16"/>
                <Button Content="{DynamicResource txtBtnLogin}" Click="BtnLogin_Click" Height="45" Padding="0" Background="{StaticResource MainGoldBrush}" Foreground="Black" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="txtError" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
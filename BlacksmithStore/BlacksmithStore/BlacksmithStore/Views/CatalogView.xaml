<UserControl x:Class="BlacksmithStore.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="CustomSwitchToggleButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MainGoldBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="SwitchTrack"
                                    Width="38"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="#777777"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0.8"/>

                            <Border x:Name="SwitchThumb"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource TextMainBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource MainGoldBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <materialDesign:ColorZone Mode="Standard" CornerRadius="5" Width="300" Margin="0,5,10,5" Background="{DynamicResource BgCardBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" Margin="8" VerticalAlignment="Center" Width="24" Height="24" Foreground="{StaticResource MainGoldBrush}"/>
                        <TextBox x:Name="SearchBox" materialDesign:HintAssist.Hint="{DynamicResource txtSearchHint}" BorderThickness="0" VerticalAlignment="Center" TextChanged="FilterChanged" Grid.Column="1" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                    </Grid>
                </materialDesign:ColorZone>

                <ToggleButton x:Name="BtnToggleFilter" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" Margin="0,5,20,5" Height="40" Width="40">
                    <materialDesign:PackIcon Kind="FilterVariant" Width="28" Height="28"/>
                </ToggleButton>

                <StackPanel x:Name="pnlEditMode" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource txtEditMode}" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0"/>

                    <ToggleButton x:Name="ToggleEditMode" 
                                  Style="{StaticResource CustomSwitchToggleButton}" 
                                  Cursor="Hand"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,2"/>
                </StackPanel>
            </WrapPanel>

            <Border Visibility="{Binding IsChecked, ElementName=BtnToggleFilter, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="15" Margin="0,5">
                <WrapPanel VerticalAlignment="Center">
                    <ComboBox x:Name="cbCategoryFilter" Width="130" materialDesign:HintAssist.Hint="{DynamicResource txtFilterTarget}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14">
                        <ComboBoxItem Tag="Жінкам" Content="{DynamicResource txtCatWomen}"/>
                        <ComboBoxItem Tag="Чоловікам" Content="{DynamicResource txtCatMen}"/>
                        <ComboBoxItem Tag="Дітям" Content="{DynamicResource txtCatKids}"/>
                    </ComboBox>

                    <ComboBox x:Name="cbSubtypeFilter" Width="140" materialDesign:HintAssist.Hint="{DynamicResource txtFilterSubtype}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14"/>

                    <ComboBox x:Name="cbSeasonFilter" Width="120" materialDesign:HintAssist.Hint="{DynamicResource txtFilterSeason}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14">
                        <ComboBoxItem Tag="Літо" Content="{DynamicResource txtSeasonSummer}"/>
                        <ComboBoxItem Tag="Осінь" Content="{DynamicResource txtSeasonAutumn}"/>
                        <ComboBoxItem Tag="Зима" Content="{DynamicResource txtSeasonWinter}"/>
                        <ComboBoxItem Tag="Весна" Content="{DynamicResource txtSeasonSpring}"/>
                        <ComboBoxItem Tag="Усі" Content="{DynamicResource txtSeasonAll}"/>
                    </ComboBox>

                    <ComboBox x:Name="cbBrandFilter" Width="140" materialDesign:HintAssist.Hint="{DynamicResource txtFilterBrand}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14"/>

                    <ComboBox x:Name="cbColorFilter" Width="120" materialDesign:HintAssist.Hint="{DynamicResource txtFilterColor}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14"/>

                    <ComboBox x:Name="cbSizeFilter" Width="100" materialDesign:HintAssist.Hint="{DynamicResource txtFilterSize}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14"/>

                    <TextBox x:Name="tbMinPrice" Width="90" materialDesign:HintAssist.Hint="{DynamicResource txtFilterPriceFrom}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" TextChanged="FilterChanged" FontSize="14"/>

                    <TextBox x:Name="tbMaxPrice" Width="90" materialDesign:HintAssist.Hint="{DynamicResource txtFilterPriceTo}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" TextChanged="FilterChanged" FontSize="14"/>

                    <ComboBox x:Name="cbStockFilter" Width="140" materialDesign:HintAssist.Hint="{DynamicResource txtFilterAvailability}" materialDesign:HintAssist.IsFloating="True" Margin="8" Foreground="{DynamicResource TextMainBrush}" SelectionChanged="FilterChanged" FontSize="14">
                        <ComboBoxItem Tag="В наявності" Content="{DynamicResource txtStockIn}"/>
                        <ComboBoxItem Tag="Скоро буде" Content="{DynamicResource txtStockOut}"/>
                    </ComboBox>

                    <Button Content="{DynamicResource txtBtnReset}" Click="ClearFilters_Click" Margin="10,8" Foreground="#FF5252" Style="{StaticResource MaterialDesignFlatButton}" FontSize="14"/>
                </WrapPanel>
            </Border>

            <TextBlock x:Name="CategoryTitle" Text="{DynamicResource txtCatalogTitle}" Foreground="{DynamicResource TextMainBrush}" FontSize="22" FontWeight="Bold" Margin="0,10"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left" Margin="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Margin="10" Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="12">
                            <Grid>
                                <StackPanel>
                                    <Border Height="235" Background="{DynamicResource BorderLineBrush}" CornerRadius="5" ClipToBounds="True">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Brand}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" Margin="0,2,0,5" Height="42" TextWrapping="Wrap" FontSize="14"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₴}" Foreground="{StaticResource MainGoldBrush}" FontSize="20" FontWeight="Bold"/>

                                    <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <materialDesign:PackIcon Kind="Warehouse" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource txtView}" Click="ViewDetails_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource MainGoldBrush}" FontSize="13" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
                                        <Button Grid.Column="1" Content="{DynamicResource txtBtnEdit}" Click="EditProduct_Click" Foreground="Orange" Style="{StaticResource MaterialDesignFlatButton}" FontSize="13" Margin="2,0,0,0" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsChecked, ElementName=ToggleEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
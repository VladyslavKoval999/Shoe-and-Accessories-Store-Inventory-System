<UserControl x:Class="BlacksmithStore.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <materialDesign:DialogHost x:Name="ReturnDialogHost" Identifier="ReturnDialogRoot" DialogTheme="Inherit">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="{DynamicResource BgCardBrush}" Padding="30" CornerRadius="15" Width="450">
                <StackPanel>
                    <TextBlock Text="{DynamicResource txtReturnProcessing}" Foreground="{DynamicResource TextMainBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding SelectedReturnItem.ProductName}" Foreground="{StaticResource MainGoldBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="{DynamicResource txtSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15"/>
                        <TextBlock Text=": " Foreground="{DynamicResource TextMutedBrush}" FontSize="15"/>
                        <TextBlock Text="{Binding SelectedReturnItem.Size}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource txtSelectQuantity}" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" FontSize="16"/>
                        <ComboBox Grid.Column="1" x:Name="cbReturnQuantity" Width="80" Foreground="{DynamicResource TextMainBrush}" FontSize="16" SelectionChanged="cbReturnQuantity_SelectionChanged"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource txtReturnReason}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,0,0,5"/>

                    <ComboBox x:Name="cbReturnReason" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,0,30">
                        <ComboBoxItem Tag="Не підійшов розмір/фасон" Content="{DynamicResource txtReasonSize}" IsSelected="True"/>
                        <ComboBoxItem Tag="Заводський брак" Content="{DynamicResource txtReasonDefect}"/>
                        <ComboBoxItem Tag="Інше" Content="{DynamicResource txtReasonOther}"/>
                    </ComboBox>

                    <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,30">
                        <TextBlock Text="{DynamicResource txtRefundAmount}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="16" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtRefundTotal" Text="0 ₴" Foreground="#FF5252" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource txtBtnCancel}" Click="CancelReturn_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,15,0" FontSize="15"/>
                        <Button Content="{DynamicResource txtBtnConfirm}" Click="ConfirmReturn_Click" Background="#FF5252" BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="15" Height="45" Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource txtReturnsTitle}" Foreground="{DynamicResource TextMainBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <materialDesign:Card Grid.Row="1" Background="{DynamicResource BgCardBrush}" Padding="20" UniformCornerRadius="10" Margin="0,0,0,20">
                <WrapPanel VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ReceiptText" Width="30" Height="30" Foreground="{StaticResource MainGoldBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="tbSearchOrder" materialDesign:HintAssist.Hint="{DynamicResource txtSearchOrderHint}" Width="250" Foreground="{DynamicResource TextMainBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource txtSearchHint}" Click="SearchOrder_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource MainGoldBrush}" Foreground="Black" FontWeight="Bold" FontSize="14" Width="120" BorderThickness="0"/>

                    <TextBlock x:Name="txtOrderInfoLabel" Text="{DynamicResource txtOrderInfo}" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="40,0,10,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="txtOrderDate" Text="" Foreground="{DynamicResource TextMainBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                </WrapPanel>
            </materialDesign:Card>

            <DataGrid Grid.Row="2" x:Name="dgOrderItems" ItemsSource="{Binding OrderItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="{DynamicResource BgDataGridBrush}" Foreground="{DynamicResource TextMainBrush}" 
                      RowBackground="{DynamicResource BgCardBrush}" FontSize="14"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Article}" Width="1.3*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtArt}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Article}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource MainGoldBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ProductName}" Width="1.8*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtName}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding ProductName}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Brand}" Width="1.2*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtBrand}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Brand}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Size}" Width="0.7*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtSize}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Quantity}" Width="0.7*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtQuantity}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding SalePrice, StringFormat={}{0:N0} ₴}" Width="1.2*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource txtPrice}"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="1.8*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource txtLawStatus}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReturnStatus}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="5,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReturnStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF5252"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReturnable}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1.4*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource txtActions}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource txtBtnReturnItem}" 
                                        Click="OpenReturnDialog_Click" 
                                        FontSize="12" 
                                        Margin="2"
                                        Padding="8,4"
                                        Height="Auto"
                                        IsEnabled="{Binding IsReturnable}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperLightButton}">
                                            <Setter Property="Background" Value="#FF5252"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource BorderLineBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
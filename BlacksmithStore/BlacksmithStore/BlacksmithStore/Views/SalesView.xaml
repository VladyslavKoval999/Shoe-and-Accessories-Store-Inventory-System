<UserControl x:Class="BlacksmithStore.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Margin="0,0,15,0" Padding="15" Background="{DynamicResource BgCardBrush}" UniformCornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource txtCartTitle}" Foreground="{DynamicResource TextMainBrush}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource txtBtnClearCart}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ClearCart_Click" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#FF5252" BorderBrush="#FF5252" Height="35" Padding="15,0"/>
                </DockPanel>

                <StackPanel x:Name="pnlEmptyCart" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CartOutline" Width="64" Height="64" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource txtEmptyCart}" Foreground="{DynamicResource TextMutedBrush}" FontSize="18" Margin="0,10,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icCartItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="5,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{DynamicResource txtArt}" Foreground="{StaticResource MainGoldBrush}" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Text=" " Foreground="{StaticResource MainGoldBrush}" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Text="{Binding Article}" Foreground="{StaticResource MainGoldBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource txtSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text=": " Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,15,0"/>

                                                <TextBlock Text="{DynamicResource txtPrice}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                                                <TextBlock Text=": " Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₴}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Button Content="-" Tag="{Binding}" Click="BtnMinus_Click" Width="34" Height="34" Padding="0" FontSize="18" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLineBrush}"/>
                                            <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextMainBrush}" FontSize="18" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                                            <Button Content="+" Tag="{Binding}" Click="BtnPlus_Click" Width="34" Height="34" Padding="0" FontSize="18" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLineBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0} ₴}" Foreground="{StaticResource MainGoldBrush}" FontWeight="Black" FontSize="20" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                            <Button Content="{DynamicResource txtBtnDelete}" Tag="{Binding}" Click="BtnRemove_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF5252" HorizontalAlignment="Right" Height="Auto" Padding="8,4" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15" Padding="0,0,5,0">
                <materialDesign:Card Padding="20" Background="{DynamicResource BgCardBrush}" UniformCornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource txtClientCardTitle}" Foreground="{DynamicResource TextMainBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="edtPhoneSearch" Grid.Column="0" materialDesign:HintAssist.Hint="{DynamicResource txtSearchPhoneBarcodeHint}" 
                                     Foreground="{DynamicResource TextMainBrush}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     TextChanged="edtPhoneSearch_TextChanged" FontSize="15" MinHeight="50" VerticalContentAlignment="Center" Padding="15,10"/>

                            <Button Grid.Column="1" Content="{DynamicResource txtBtnFind}" Click="FindCustomer_Click" Height="50" Margin="10,0,0,0" Background="#333333" Foreground="White" BorderThickness="0" Padding="15,0" FontSize="14"/>
                        </Grid>

                        <Border x:Name="pnlCustomerInfo" Visibility="Collapsed" Margin="0,20,0,0" CornerRadius="12" Background="#141414" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#A67C27" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                                    <materialDesign:PackIcon Kind="CheckDecagram" Foreground="#A67C27" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource txtClientFoundUpper}" Foreground="#A67C27" FontWeight="Black" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignToolButton}" Width="24" Height="24" Padding="0" Click="ClearCustomer_Click" ToolTip="{DynamicResource txtBtnCancel}">
                                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="16" Height="16"/>
                                    </Button>
                                </DockPanel>

                                <TextBlock x:Name="txtCustomerName" Grid.Row="1" Text="-" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtCardNumber" Grid.Row="2" Text="BS-XXXX-XXXX" Foreground="#888888" FontSize="14" Margin="0,0,0,20"/>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource txtBonusProgressTitle}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtBonusProgress" Text="0 / 10" Foreground="#A67C27" FontSize="20" FontWeight="Black"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{DynamicResource txtAvailDiscountsTitle}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="txtAvailableBonuses" Text="0" Foreground="#A67C27" FontSize="20" FontWeight="Black" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Button x:Name="btnApplyDiscount" Content="{DynamicResource txtBtnApplyDiscount}" Click="ApplyDiscount_Click" IsEnabled="False" 
                                Margin="0,15,0,0" Height="45" Background="#A67C27" Foreground="Black" FontWeight="Black" FontSize="14" BorderThickness="0"/>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>

            <materialDesign:Card Grid.Row="1" Padding="20" Background="{DynamicResource BgCardBrush}" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource txtReceiptSummary}" Foreground="{DynamicResource TextMainBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource txtItemsSum}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="txtSubtotal" Text="0 ₴" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource txtBonusDiscount}" FontSize="16" Foreground="#FF5252"/>
                        <TextBlock x:Name="txtDiscount" Text="-0 ₴" FontSize="16" FontWeight="SemiBold" Foreground="#FF5252" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="{DynamicResource txtToPay}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtFinalTotal" Text="0 ₴" FontSize="28" FontWeight="Black" Foreground="{StaticResource MainGoldBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="{DynamicResource txtConfirmSale}" Click="Checkout_Click" Height="55" FontSize="16" FontWeight="Black" Background="Black" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#CC000000">
            <materialDesign:Card Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25" UniformCornerRadius="12">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#FF5252" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource txtClearCartTitle}" FontWeight="Bold" FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center" Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="{DynamicResource txtClearCartConfirm}" TextWrapping="Wrap" Margin="0,0,0,25" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource txtBtnCancel}" Click="DialogNo_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,15,0" Width="130"/>
                        <Button Content="{DynamicResource txtBtnClearCart}" Click="DialogYes_Click" Background="#FF5252" BorderBrush="#FF5252" Foreground="White" Width="130"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
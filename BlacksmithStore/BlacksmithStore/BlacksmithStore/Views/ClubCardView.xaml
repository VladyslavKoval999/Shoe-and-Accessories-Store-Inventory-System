<UserControl x:Class="BlacksmithStore.Views.ClubCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="VisibleNavTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="20,15"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MainGoldBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                    <Setter Property="Background" Value="#0AFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,30,0">
            <TextBlock Text="{DynamicResource txtLoyaltyManagement}" Foreground="{DynamicResource TextMainBrush}" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>

            <materialDesign:Card Background="{DynamicResource BgCardBrush}" UniformCornerRadius="15" Padding="0" VerticalAlignment="Top">
                <TabControl Style="{StaticResource MaterialDesignTabControl}" Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">

                    <TabItem Style="{StaticResource VisibleNavTabItemStyle}">
                        <TabItem.Header>
                            <TextBlock Text="{DynamicResource txtTabIssueCard}" FontSize="14" FontWeight="Bold"/>
                        </TabItem.Header>
                        <StackPanel Margin="30">
                            <TextBlock Text="{DynamicResource txtRegisterSys}" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" Margin="0,0,0,20"/>

                            <TextBox x:Name="edtCustLogin" materialDesign:HintAssist.Hint="{DynamicResource txtLoginCardHint}"
                                     Foreground="{DynamicResource TextMainBrush}" Margin="0,10" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontSize="16" TextChanged="Input_TextChanged"/>

                            <TextBox x:Name="edtCustFullName" materialDesign:HintAssist.Hint="{DynamicResource txtFullNameHint}"
                                     Foreground="{DynamicResource TextMainBrush}" Margin="0,10" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontSize="16"/>

                            <TextBox x:Name="edtCustPhone" materialDesign:HintAssist.Hint="{DynamicResource txtPhoneHint}"
                                     Foreground="{DynamicResource TextMainBrush}" Margin="0,10" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontSize="16" MaxLength="17" TextChanged="PhoneInput_TextChanged" 
                                     GotFocus="edtCustPhone_GotFocus" PreviewKeyDown="edtCustPhone_PreviewKeyDown"/>

                            <TextBox x:Name="edtCustEmail" materialDesign:HintAssist.Hint="{DynamicResource txtEmailHint}"
                                     Foreground="{DynamicResource TextMainBrush}" Margin="0,10" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontSize="16"/>

                            <PasswordBox x:Name="edtCustPassword" materialDesign:HintAssist.Hint="{DynamicResource txtPassHint}"
                                         Foreground="{DynamicResource TextMainBrush}" Margin="0,10" 
                                         Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"
                                         FontSize="16"/>

                            <Button Content="{DynamicResource txtBtnGenSave}" Click="CreateCard_Click"
                                    Height="55" Background="{StaticResource MainGoldBrush}" Foreground="Black"
                                    FontWeight="Bold" Margin="0,40,0,0" FontSize="16"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Style="{StaticResource VisibleNavTabItemStyle}">
                        <TabItem.Header>
                            <TextBlock Text="{DynamicResource txtTabSearchClient}" FontSize="14" FontWeight="Bold"/>
                        </TabItem.Header>
                        <StackPanel Margin="30">
                            <TextBlock Text="{DynamicResource txtScanQrHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" Margin="0,0,0,20"/>

                            <Grid Margin="0,10,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="edtSearchClient" materialDesign:HintAssist.Hint="{DynamicResource txtSearchQrHint}"
                                         Foreground="{DynamicResource TextMainBrush}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         FontSize="15" VerticalAlignment="Center" TextChanged="edtSearchClient_TextChanged"/>
                                <Button Grid.Column="1" Click="SearchCustomer_Click" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" Background="{StaticResource MainGoldBrush}" BorderThickness="0" Margin="15,0,0,0">
                                    <materialDesign:PackIcon Kind="Search" Width="24" Height="24" Foreground="Black"/>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="pnlActionBonus" Visibility="Collapsed" Margin="0,0,0,20">
                                <Button Content="{DynamicResource txtBtnConnectBonusToSale}" Click="ConnectBonusToSale_Click" Height="45" Background="{StaticResource MainGoldBrush}" Foreground="Black" FontWeight="Bold" FontSize="15" BorderThickness="0"/>
                            </StackPanel>

                            <Border Background="#1AFFFFFF" CornerRadius="10" Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource MainGoldBrush}" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource txtClubRules}" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource txtRule1}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,2"/>
                                    <TextBlock Text="{DynamicResource txtRule2}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,2"/>
                                    <TextBlock Text="{DynamicResource txtRule3}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Style="{StaticResource VisibleNavTabItemStyle}">
                        <TabItem.Header>
                            <TextBlock Text="{DynamicResource txtTabClientBase}" FontSize="14" FontWeight="Bold"/>
                        </TabItem.Header>
                        <StackPanel Margin="20">
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="{DynamicResource txtClientList}" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource txtEditMode}" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <ToggleButton x:Name="ToggleEditMode" 
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                                  Foreground="{StaticResource MainGoldBrush}" 
                                                  Background="{DynamicResource TextMutedBrush}" 
                                                  BorderBrush="{DynamicResource TextMainBrush}" 
                                                  Cursor="Hand"
                                                  Checked="ToggleEditMode_Changed" 
                                                  Unchecked="ToggleEditMode_Changed"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBox x:Name="edtSearchDatabase" materialDesign:HintAssist.Hint="{DynamicResource txtSearchQrHint}"
                                     Foreground="{DynamicResource TextMainBrush}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontSize="15" Margin="0,0,0,15" TextChanged="SearchDatabase_TextChanged"/>

                            <DataGrid x:Name="dgCustomers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                      Height="300" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" 
                                      BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" RowBackground="Transparent"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderLineBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource txtColCardNum}" Binding="{Binding CardNumber}" IsReadOnly="True" Width="1.1*"/>
                                    <DataGridTextColumn Header="{DynamicResource txtLogin}" Binding="{Binding Login}" Width="1*"/>
                                    <DataGridTextColumn Header="{DynamicResource txtColFullName}" Binding="{Binding FullName}" Width="1.4*"/>
                                    <DataGridTextColumn Header="{DynamicResource txtPhoneHint}" Binding="{Binding Phone}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*"/>
                                    <DataGridTextColumn Header="{DynamicResource txtColItems}" Binding="{Binding ItemsCount}" IsReadOnly="True" Width="0.7*"/>
                                    <DataGridTextColumn Header="{DynamicResource txtColBonuses}" Binding="{Binding Bonuses}" IsReadOnly="True" Width="0.7*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                                <Button x:Name="BtnDeleteCustomer" Content="{DynamicResource txtBtnDelSelected}" Click="DeleteCustomer_Click" 
                                        Visibility="Collapsed" Height="45" Background="#E53935" Foreground="White" 
                                        FontWeight="Bold" Margin="0,0,15,0" FontSize="14" BorderThickness="0"/>
                                <Button x:Name="BtnSaveChanges" Content="{DynamicResource txtBtnSaveChanges}" Click="SaveChanges_Click" 
                                        Visibility="Collapsed" Height="45" Background="#81C784" Foreground="Black" 
                                        FontWeight="Bold" FontSize="14" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>
        </StackPanel>

        <Border Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Width="420">
            <StackPanel>
                <Border Width="80" Height="80" CornerRadius="40" BorderBrush="{StaticResource MainGoldBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,15" Background="Transparent">
                    <TextBlock x:Name="txtAvatarInitials" Text="?" Foreground="{StaticResource MainGoldBrush}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="txtClientNameDisplay" Text="{DynamicResource txtLoginCardHint}" Foreground="{DynamicResource TextMainBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap" TextAlignment="Center"/>

                <Border Background="Transparent" Width="350" Height="220" Margin="0,0,0,30" MouseLeftButtonDown="Card_MouseDown" Cursor="Hand" ToolTip="Натисніть, щоб перевернути">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CardScaleTransform" ScaleX="1" CenterX="175" CenterY="110"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Border x:Name="CardFront" CornerRadius="12" ClipToBounds="True" BorderBrush="#333333" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A1A1D" Offset="0"/>
                                    <GradientStop Color="#050505" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="8" Opacity="0.7"/>
                            </Border.Effect>
                            <Grid>
                                <Ellipse Width="350" Height="350" Margin="-100,-150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.15" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FD7E14" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <Grid Margin="20">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Anvil" Foreground="{StaticResource MainGoldBrush}" Width="22" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="BLACKSMITH STORE" Foreground="#E0E0E0" FontWeight="Black" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <materialDesign:PackIcon Kind="ContactlessPayment" Foreground="#888888" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="CreditCardChipOutline" Foreground="#B0B0B0" Width="34" Height="34" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock x:Name="lblCardNumber" Text="BS-XXXX-XXXX" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,15,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.8"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock x:Name="lblCardFullName" Text="{DynamicResource txtDefaultClient}" Foreground="{StaticResource MainGoldBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" MaxWidth="220" Typography.Capitals="AllSmallCaps"/>

                                    <TextBlock Text="CLUB CARD" Foreground="#888888" FontSize="11" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="CardBack" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Visibility="Collapsed" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1A1A1A" Offset="0"/>
                                    <GradientStop Color="#000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="8" Opacity="0.7"/>
                            </Border.Effect>

                            <Grid>
                                <Border Height="45" Background="#050505" VerticalAlignment="Top" Margin="0,20,0,0"/>

                                <Grid Margin="20,85,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="White" Padding="6" CornerRadius="8" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FD7E14" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                                        </Border.Effect>
                                        <Image x:Name="imgQrCodeBack" Width="70" Height="70" Stretch="Uniform"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblCardNumberBack" Text="BS-XXXX-XXXX" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,5"/>
                                        <TextBlock Text="SECURITY VERIFIED" Foreground="{StaticResource MainGoldBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <Border Height="2" Background="#333333" Margin="0,5,0,10"/>
                                        <TextBlock Text="BLACKSMITH CLUB MEMBER" Foreground="#AAAAAA" FontSize="10" FontWeight="Black"/>
                                        <TextBlock Text="Non-transferable | Est. 2026" Foreground="#666666" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <DockPanel Margin="0,5">
                    <TextBlock Text="{DynamicResource txtBoughtItems}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15"/>
                    <TextBlock x:Name="lblItemsCount" Text="0" Foreground="{DynamicResource TextMainBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,15,0,20">
                    <TextBlock Text="{DynamicResource txtAvailDiscountsCard}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15"/>
                    <TextBlock x:Name="lblBonuses" Text="0" Foreground="{StaticResource MainGoldBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="{DynamicResource txtToNextBonus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="lblProgressText" Text="0%" Foreground="{StaticResource MainGoldBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <ProgressBar x:Name="pbBonusProgress" Value="0" Maximum="10" Height="6" Margin="0,5,0,10" Foreground="{StaticResource MainGoldBrush}" Background="{DynamicResource BorderLineBrush}" BorderThickness="0"/>

                <TextBlock x:Name="lblItemsLeft" Text="{DynamicResource txtItemsLeftToBuy}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" HorizontalAlignment="Right"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
@model List<BlacksmithStoreWeb.Models.Product>
@{
    ViewData["Title"] = "Новинки 🔥";
}

<div class="premium-page-hero text-center mb-5">
    <div class="hero-bg-glow"></div>
    <div class="container position-relative" style="z-index: 2;">
        <h1 class="premium-hero-title" style="color: var(--bs-orange);">НОВІ НАДХОДЖЕННЯ</h1>
        <p class="premium-hero-subtitle">
            Найсвіжіші дропи цього сезону. Хапай те, що сподобалось, поки не розібрали.
        </p>
        <div class="premium-counter-badge">
            Додано за тиждень: <span>@Model.Count</span>
        </div>
    </div>
</div>

<div class="container mb-5 pb-5">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 staggered-grid">
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_ProductCard", item)
        }
    </div>
</div>

<style>
    .premium-page-hero {
        background: linear-gradient(135deg, #0a0a0a 0%, #151515 100%);
        padding: 70px 20px;
        position: relative;
        overflow: hidden;
        border-bottom: 2px solid var(--bs-orange);
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }

    .hero-bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60%;
        height: 60%;
        background: radial-gradient(circle, rgba(253, 126, 20, 0.08) 0%, transparent 70%);
        pointer-events: none;
    }

    .premium-hero-title {
        color: #fff;
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
        text-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .premium-hero-subtitle {
        color: #aaa;
        font-size: 1.1rem;
        margin-bottom: 25px;
    }

    .premium-counter-badge {
        display: inline-block;
        background-color: rgba(0,0,0,0.5);
        border: 1px solid #333;
        color: #ccc;
        padding: 8px 25px;
        border-radius: 30px;
        font-weight: bold;
        backdrop-filter: blur(5px);
    }

        .premium-counter-badge span {
            color: var(--bs-orange);
            font-size: 1.1rem;
            margin-left: 5px;
        }

    .premium-grid-item {
        opacity: 0;
        transform: translateY(20px);
        animation: gridFadeIn 0.5s ease forwards;
    }

    @@keyframes gridFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const grid = document.querySelector('.staggered-grid');
        if (grid) { Array.from(grid.children).forEach((item, index) => { item.style.animationDelay = `${index * 0.08}s`; }); }
    });
</script>
@model IEnumerable<BlacksmithStoreWeb.Models.Product>

@{
    ViewData["Title"] = "Під замовлення";
}

<div class="premium-page-hero text-center mb-5">
    <div class="hero-bg-glow" style="background: radial-gradient(circle, rgba(255, 140, 0, 0.08) 0%, transparent 70%);"></div>
    <div class="container position-relative" style="z-index: 2;">
        <h1 class="premium-hero-title">ПІД ЗАМОВЛЕННЯ</h1>
        <p class="premium-hero-subtitle">Взуття та аксесуари, яких тимчасово немає в наявності. Оберіть модель, щоб переглянути відсутні розміри та залишити запит.</p>
    </div>
</div>

<div class="container-fluid mb-5 pb-5" style="max-width: 1400px; min-height: 50vh;">

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 row-cols-xl-5 g-4 staggered-grid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 w-100 slide-up">
                <div style="font-size: 4rem; opacity: 0.5; margin-bottom: 20px;">✅</div>
                <h3 class="text-light fw-bold mb-3">Наразі всі товари та розміри є в наявності!</h3>
                <a asp-controller="Home" asp-action="Catalog" class="btn px-4 py-2" style="background-color: var(--bs-orange); color: #fff; font-weight: bold; text-shadow: 0px 1px 3px rgba(0,0,0,0.4);">Назад до каталогу</a>
            </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                string imageUrl = "/img/placeholder.jpg";
                if (!string.IsNullOrEmpty(product.Images))
                {
                    var firstImageStr = product.Images.Split(',')[0].Trim();
                    var fileName = System.IO.Path.GetFileName(firstImageStr);
                    imageUrl = $"/Images/Product/{fileName}";
                }

                <div class="col premium-grid-item slide-up">
                    <div class="card h-100 product-card" style="background-color: #121212; border: 1px solid #282828; border-radius: 16px; overflow: hidden; position: relative; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);">

                        <a asp-controller="Restock" asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none d-block">
                            <div style="position: relative; aspect-ratio: 4/5; background-color: #1a1a1a; overflow: hidden;">
                                <div style="position: absolute; top: 10px; left: 10px; background: rgba(220, 53, 69, 0.9); color: white; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; z-index: 2;">Під замовлення</div>

                                <button class="card-fav-btn" data-id="@product.ProductId" onclick="event.preventDefault(); toggleFavorite(@product.ProductId);" title="Додати до вподобань" style="position: absolute; top: 10px; right: 10px; z-index: 3; background: rgba(0,0,0,0.5); border: none; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1rem; transition: all 0.3s ease;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z" /></svg>
                                </button>

                                <img src="@imageUrl" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'" onerror="this.src='/img/placeholder.jpg';" />
                            </div>
                        </a>

                        <div class="card-body p-3 d-flex flex-column justify-content-between" style="background: linear-gradient(180deg, #121212 0%, #0a0a0a 100%);">
                            <div>
                                <small style="color: #666; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 1px; font-weight: bold;">@(product.ProductType ?? "Товар")</small>
                                <h5 class="card-title text-light mt-1 mb-2" style="font-size: 0.95rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@product.Name">
                                    @product.Name
                                </h5>
                            </div>
                            <div class="mt-auto pt-2" style="border-top: 1px solid #222;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span style="color: var(--bs-orange); font-weight: bold; font-size: 1.1rem;">@Math.Round(product.BasePrice) ₴</span>
                                </div>
                                <a asp-controller="Restock" asp-action="Details" asp-route-id="@product.ProductId" class="btn w-100" style="background-color: transparent; color: #fff; text-shadow: 0px 1px 2px rgba(0,0,0,0.5); border: 1px solid var(--bs-orange); border-radius: 8px; font-weight: bold; font-size: 0.8rem; padding: 6px; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='var(--bs-orange)'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#fff';">
                                    @(product.ProductType == "Взуття" ? "Переглянути відсутні розміри" : "Залишити запит")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .premium-page-hero {
        background: linear-gradient(135deg, #0a0a0a 0%, #151515 100%);
        padding: 70px 20px;
        position: relative;
        overflow: hidden;
        border-bottom: 2px solid var(--bs-orange);
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }

    .hero-bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60%;
        height: 60%;
        pointer-events: none;
    }

    .premium-hero-title {
        color: #fff;
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
        text-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .premium-hero-subtitle {
        color: #aaa;
        font-size: 1.1rem;
        margin-bottom: 25px;
    }

    .premium-grid-item {
        opacity: 0;
        transform: translateY(20px);
        animation: gridFadeIn 0.5s ease forwards;
    }

    .card-fav-btn:hover {
        background-color: var(--bs-orange) !important;
        color: #000 !important;
    }

    @@keyframes gridFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const grid = document.querySelector('.staggered-grid');
        if (grid) { Array.from(grid.children).forEach((item, index) => { item.style.animationDelay = `${index * 0.08}s`; }); }
    });
</script>
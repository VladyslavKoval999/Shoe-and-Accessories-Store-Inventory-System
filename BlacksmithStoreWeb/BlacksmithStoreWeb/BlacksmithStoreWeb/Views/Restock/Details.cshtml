                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fade-in-page {
        animation: fadeInUi 0.5s ease-in-out forwards;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #888;
        text-decoration: none;
        font-weight: bold;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

        .btn-back:hover {
            color: var(--bs-orange);
        }

    .sticky-gallery {
        position: sticky;
        top: 30px;
    }

    .main-image-wrapper {
        position: relative;
        aspect-ratio: 4 / 5;
        background-color: #161616;
        border: 1px solid #282828;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        max-width: 420px;
        margin: 0 auto;
    }

    .main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumbnail-scroll-container {
        overflow-x: auto;
        max-width: 420px;
        margin: 0 auto;
    }

        .thumbnail-scroll-container::-webkit-scrollbar {
            height: 0px;
        }

    .thumb-box {
        width: 75px;
        height: 75px;
        border-radius: 10px;
        border: 1px solid #252525;
        overflow: hidden;
        background-color: #161616;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

        .thumb-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .thumb-box:hover, .thumb-box.active {
            border-color: var(--bs-orange);
            transform: scale(0.95);
            box-shadow: 0 0 8px rgba(253, 126, 20, 0.3);
        }

    .product-premium-panel {
        background-color: #111111;
        border: 1px solid #222222;
        border-radius: 16px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.4);
    }

    .badge-type {
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1.2px;
    }

    .fs-7 {
        font-size: 0.8rem;
    }

    .product-title-text {
        color: #fff;
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .premium-price-box {
        display: flex;
        align-items: baseline;
        color: #aaa;
        font-weight: 900;
    }

    .price-amount {
        font-size: 2.8rem;
        letter-spacing: -0.5px;
    }

    .price-currency {
        font-size: 1.4rem;
        margin-left: 4px;
    }

    .divider-line {
        border-color: #282828;
        opacity: 1;
    }

    .panel-label {
        color: #fff;
        font-weight: bold;
        font-size: 0.95rem;
    }

    .size-grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(65px, 1fr));
        gap: 10px;
    }

    .size-grid-label {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #181818;
        color: #fff;
        border: 1px solid #333;
        padding: 12px 0;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin: 0;
    }

    .btn-check:checked + .size-grid-label {
        background-color: var(--bs-orange) !important;
        color: #000 !important;
        border-color: var(--bs-orange) !important;
        box-shadow: 0 0 12px rgba(253, 126, 20, 0.4);
    }

    .btn-check:not(:checked) + .size-grid-label:hover {
        border-color: #555;
        background-color: #222;
    }

    .error-msg-box {
        color: #ff4d4d;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .btn-action-cart {
        width: 100%;
        height: 48px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.25s ease;
        font-weight: bold;
    }

        .btn-action-cart:hover {
            background-color: var(--bs-orange) !important;
            color: #000 !important;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(253, 126, 20, 0.4);
        }

    .btn-action-fav {
        width: 100%;
        height: 48px;
        background-color: #181818;
        border: 1px solid #333;
        color: #fff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.25s ease;
        padding: 0;
    }

        .btn-action-fav:hover {
            border-color: #ff4d4d;
            color: #ff4d4d;
            background-color: #222;
        }

        .btn-action-fav.active {
            color: #ff4d4d !important;
            border-color: #ff4d4d;
            background-color: rgba(255, 77, 77, 0.12);
            filter: drop-shadow(0 0 4px rgba(255, 77, 77, 0.4));
        }

    .premium-tabs-nav {
        border-bottom: 2px solid #222;
    }

    .nav-tab-link {
        background: none;
        border: none;
        color: #666;
        font-weight: bold;
        padding: 10px 0;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
    }

        .nav-tab-link.active {
            color: var(--bs-orange);
            border-bottom-color: var(--bs-orange);
        }

    .desc-text-content {
        color: #bbb;
        font-size: 0.95rem;
        line-height: 1.6;
        white-space: pre-line;
    }

    .size-modal-link {
        color: #777;
        font-size: 0.85rem;
        font-weight: bold;
        transition: color 0.2s;
    }

        .size-modal-link:hover {
            color: var(--bs-orange);
        }

    .custom-pills .nav-link {
        color: #888;
        font-weight: bold;
        border-radius: 50px;
        padding: 8px 20px;
        margin: 0 4px;
        transition: 0.3s;
    }

        .custom-pills .nav-link:hover {
            color: #fff;
        }

        .custom-pills .nav-link.active {
            background-color: var(--bs-orange) !important;
            color: #000 !important;
        }

    .table-scroll-container {
        max-height: 350px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-orange) #222;
    }

        .table-scroll-container::-webkit-scrollbar {
            width: 6px;
        }

        .table-scroll-container::-webkit-scrollbar-thumb {
            background-color: var(--bs-orange);
            border-radius: 10px;
        }

    .sticky-thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #1a1a1a;
        box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .style-premium-table th, .style-premium-table td {
        border-color: #222 !important;
    }

    @@keyframes fadeInUi {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<script>
    function changeMainImage(src, thumbElement) {
        document.getElementById('mainProductImage').src = src;
        document.querySelectorAll('.thumb-box').forEach(b => b.classList.remove('active'));
        thumbElement.classList.add('active');
    }

    function validateNotifyForm() {
        const radios = document.getElementsByName('size');
        const err = document.getElementById('sizeValidationError');

        if (radios.length > 0) {
            let selected = false;
            for (let r of radios) {
                if (r.checked) { selected = true; break; }
            }
            if (!selected) {
                err.classList.remove('d-none');
                return false;
            } else {
                err.classList.add('d-none');
            }
        }
        return true;
    }

    function toggleFavoritePage(productId) {
        toggleFavorite(productId);
        setTimeout(() => {
            const btn = document.querySelector('.btn-action-fav');
            if(btn) {
                const cardButtons = document.querySelectorAll(`.card-fav-btn[data-id="${productId}"]`);
                if(cardButtons.length > 0 && cardButtons[0].classList.contains('active')) {
                    btn.classList.add('active');
                } else if(cardButtons.length > 0) {
                    btn.classList.remove('active');
                } else {
                    btn.classList.toggle('active');
                }
            }
        }, 250);
    }
</script>
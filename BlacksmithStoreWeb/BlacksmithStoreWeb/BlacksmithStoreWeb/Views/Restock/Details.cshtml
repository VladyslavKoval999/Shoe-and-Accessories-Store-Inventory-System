@model BlacksmithStoreWeb.Models.RestockProductDetailsViewModel
@using Microsoft.AspNetCore.Http
@using System.Text.Json

@{
    ViewData["Title"] = "Запит: " + Model.Product.Name;

    var favJson = Context.Session.GetString("Favorites");
    var favIds = string.IsNullOrEmpty(favJson)
        ? new List<int>()
        : JsonSerializer.Deserialize<List<int>>(favJson) ?? new List<int>();

    bool isFavorite = favIds.Contains(Model.Product.ProductId);

    var imageList = new List<string>();
    if (!string.IsNullOrEmpty(Model.Product.Images))
    {
        imageList = Model.Product.Images.Split(',')
            .Select(img => $"/Images/Product/{System.IO.Path.GetFileName(img.Trim())}")
            .ToList();
    }
    else
    {
        imageList.Add("/Images/placeholder.jpg");
    }
}

<div class="container mt-5 mb-5 fade-in-page">
    <div class="mb-4 text-start" style="max-width: 1000px; margin: 0 auto;">
        <a asp-action="Index" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
            </svg>
            Назад до списку "Під замовлення"
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 mx-auto" style="max-width: 1000px; background-color: #153015; border: 1px solid #28a745; color: #4caf50; border-radius: 12px;">
            <strong>Успішно!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show mb-4 mx-auto" style="max-width: 1000px; background-color: #0c2b3d; border: 1px solid #17a2b8; color: #17a2b8; border-radius: 12px;">
            <strong>Інформація:</strong> @TempData["InfoMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 mx-auto" style="max-width: 1000px; background-color: #3d0c0c; border: 1px solid #dc3545; color: #ff4d4d; border-radius: 12px;">
            <strong>Помилка:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5 justify-content-center" style="max-width: 1100px; margin: 0 auto;">
        <div class="col-lg-5">
            <div class="sticky-gallery">
                <div class="main-image-wrapper mb-3">
                    <img id="mainProductImage" src="@imageList[0]" alt="@Model.Product.Name" class="main-img" onerror="this.onerror=null; this.src='/Images/placeholder.jpg';" />
                </div>

                @if (imageList.Count > 1)
                {
                    <div class="d-flex gap-2 pb-2 thumbnail-scroll-container">
                        @for (int i = 0; i < imageList.Count; i++)
                        {
                            <div class="thumb-box @(i == 0 ? "active" : "")" onclick="changeMainImage('@imageList[i]', this)">
                                <img src="@imageList[i]" alt="Прев'ю @i" onerror="this.onerror=null; this.src='/Images/placeholder.jpg';" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="product-premium-panel p-4">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge-type" style="color: #dc3545;">НЕМАЄ В НАЯВНОСТІ</span>
                    @if (!string.IsNullOrEmpty(Model.Product.Article))
                    {
                        <span class="text-muted fs-7">Артикул: <strong class="text-light">@Model.Product.Article</strong></span>
                    }
                </div>

                <h1 class="product-title-text mb-3">@Model.Product.Name</h1>

                <div class="premium-price-box mb-4">
                    <span class="price-amount">@Math.Round(Model.Product.BasePrice)</span>
                    <span class="price-currency">₴</span>
                </div>

                <hr class="divider-line mb-4" />

                <form asp-controller="Restock" asp-action="RequestNotification" method="post" id="notifyForm" onsubmit="return validateNotifyForm()">
                    <input type="hidden" name="productId" value="@Model.Product.ProductId" />

                    @if (Model.Product.ProductType == "Взуття" && Model.OutOfStockSizes.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="panel-label" style="color: #ff9800;">Оберіть відсутній розмір для сповіщення:</label>
                                <a href="#sizeGuideModal" data-bs-toggle="modal" class="size-modal-link">Таблиця розмірів</a>
                            </div>

                            <div class="size-grid-container">
                                @foreach (var size in Model.OutOfStockSizes)
                                {
                                    <div class="size-grid-item">
                                        <input type="radio" name="size" value="@size" id="size_@size" class="btn-check" />
                                        <label for="size_@size" class="size-grid-label">@size</label>
                                    </div>
                                }
                            </div>

                            <div class="error-msg-box d-none mt-2" id="sizeValidationError">
                                ⚠️ Будь ласка, оберіть розмір, якого ви очікуєте.
                            </div>
                        </div>
                    }
                    else if (Model.Product.ProductType == "Взуття" && !Model.OutOfStockSizes.Any())
                    {
                        <div class="alert alert-info mb-4" style="background-color: #0c2b3d; border: 1px solid #17a2b8; color: #17a2b8; border-radius: 12px;">
                            Усі розміри даного товару наразі є в наявності. Перейдіть до каталогу для покупки.
                        </div>
                    }

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-sm-10">
                            <button type="submit" class="btn-action-cart" style="background-color: transparent; color: #fff; border: 2px solid var(--bs-orange);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-bell-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z" />
                                </svg>
                                СПОВІСТИТИ ПРО НАЯВНІСТЬ
                            </button>
                        </div>

                        <div class="col-sm-2">
                            <button type="button" class="btn-action-fav @(isFavorite ? "active" : "")"
                                    data-id="@Model.Product.ProductId"
                                    onclick="toggleFavoritePage(@Model.Product.ProductId)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </form>

                <div class="mt-4 pt-2">
                    <nav class="premium-tabs-nav">
                        <div class="nav nav-tabs border-0 gap-3" id="nav-tab" role="tablist">
                            <button class="nav-tab-link active" id="nav-desc-tab" data-bs-toggle="tab" data-bs-target="#nav-desc" type="button" role="tab">Опис товару</button>
                        </div>
                    </nav>
                    <div class="tab-content premium-tab-body mt-3" id="nav-tabContent">
                        <div class="tab-pane fade show active" id="nav-desc" role="tabpanel">
                            @if (!string.IsNullOrEmpty(Model.Product.Description))
                            {
                                <p class="desc-text-content">@Model.Product.Description</p>
                            }
                            else
                            {
                                <p class="text-muted italic-text">Опис для даного товару тимчасово відсутній.</p>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-light" style="background-color: #121212; border: 1px solid #333; border-radius: 12px; overflow: hidden;">
            <div class="modal-header" style="border-bottom: 1px solid #222;">
                <h5 class="modal-title fw-bold" style="color: var(--bs-orange); letter-spacing: 0.5px;">ТАБЛИЦЯ РОЗМІРІВ (EU)</h5>

                                    <tr><td class="py-2">43</td><td class="py-2">27.5 см</td></tr>
                                    <tr><td class="py-2">44</td><td class="py-2">28.5 см</td></tr>
                                    <tr><td class="py-2">45</td><td class="py-2">29.0 см</td></tr>
                                    <tr><td class="py-2">46</td><td class="py-2">29.5 см</td></tr>
                                    <tr><td class="py-2">47</td><td class="py-2">30.5 см</td></tr>
                                    <tr><td class="py-2">48</td><td class="py-2">31.0 см</td></tr>
                                    <tr><td class="py-2">49</td><td class="py-2">31.5 см</td></tr>
                                    <tr><td class="py-2">50</td><td class="py-2">32.5 см</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="womens-sizes-restock" role="tabpanel">
                        <div class="table-scroll-container">
                            <table class="table table-dark table-striped text-center mb-0 style-premium-table">
                                <thead class="sticky-thead">
                                    <tr style="color: var(--bs-orange); background-color: #1a1a1a;">
                                        <th class="py-3">Розмір (EU)</th>
                                        <th class="py-3">Довжина устілки</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td class="py-2">36</td><td class="py-2">22.5 см</td></tr>
                                    <tr><td class="py-2">37</td><td class="py-2">23.5 см</td></tr>
                                    <tr><td class="py-2">38</td><td class="py-2">24.0 см</td></tr>
                                    <tr><td class="py-2">39</td><td class="py-2">25.0 см</td></tr>
                                    <tr><td class="py-2">40</td><td class="py-2">25.5 см</td></tr>
                                    <tr><td class="py-2">41</td><td class="py-2">26.5 см</td></tr>
                                    <tr><td class="py-2">42</td><td class="py-2">27.0 см</td></tr>
                                    <tr><td class="py-2">43</td><td class="py-2">27.5 см</td></tr>
                                    <tr><td class="py-2">44</td><td class="py-2">28.5 см</td></tr>
                                    <tr><td class="py-2">45</td><td class="py-2">29.0 см</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="kids-sizes-restock" role="tabpanel">
                        <div class="table-scroll-container">
                            <table class="table table-dark table-striped text-center mb-0 style-premium-table">
                                <thead class="sticky-thead">
                                    <tr style="color: var(--bs-orange); background-color: #1a1a1a;">
                                        <th class="py-3">Розмір (EU)</th>
                                        <th class="py-3">Довжина устілки</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td class="py-2">21</td><td class="py-2">13.0 см</td></tr>

@model BlacksmithStoreWeb.Models.Product
@using Microsoft.AspNetCore.Http
@using System.Text.Json

@{
    var favJson = Context.Session.GetString("Favorites");
    var favIds = string.IsNullOrEmpty(favJson)
        ? new List<int>()
        : JsonSerializer.Deserialize<List<int>>(favJson) ?? new List<int>();

    bool isFavorite = favIds.Contains(Model.ProductId);

    string imageUrl = "/Images/placeholder.jpg";
    if (!string.IsNullOrEmpty(Model.Images))
    {
        var firstImageStr = Model.Images.Split(',')[0].Trim();
        var fileName = System.IO.Path.GetFileName(firstImageStr);
        imageUrl = $"/Images/Product/{fileName}";
    }
}

<div class="col premium-grid-item">
    <div class="card h-100 product-card" style="background-color: #121212; border: 1px solid #282828; border-radius: 16px; overflow: hidden; position: relative; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);">

        <button class="card-fav-btn @(isFavorite ? "active" : "")"
                data-id="@Model.ProductId"
                onclick="toggleFavorite(@Model.ProductId); event.preventDefault(); event.stopPropagation();"
                title="@(isFavorite ? "Видалити з вподобань" : "Додати до вподобань")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z" />
            </svg>
        </button>

        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none">
            <div style="position: relative; aspect-ratio: 4/5; background-color: #1a1a1a; overflow: hidden;">
                <img src="@imageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
                     onmouseover="this.style.transform='scale(1.08)'"
                     onmouseout="this.style.transform='scale(1)'"
                     onerror="this.onerror=null; this.src='/Images/placeholder.jpg';" />
            </div>
        </a>

        <div class="card-body p-3 d-flex flex-column justify-content-between" style="background: linear-gradient(180deg, #121212 0%, #0a0a0a 100%);">
            <div>
                <small style="color: #666; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; font-weight: bold;">@(Model.ProductType ?? "Товар")</small>
                <h5 class="card-title text-light mt-1 mb-2" style="font-size: 1.05rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@Model.Name">
                    @Model.Name
                </h5>
            </div>

            <div class="mt-2 d-flex justify-content-between align-items-center">
                <span style="color: var(--bs-orange); font-weight: 900; font-size: 1.2rem; letter-spacing: -0.5px;">@Math.Round(Model.BasePrice) ₴</span>
                <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-sm d-flex align-items-center justify-content-center" style="background-color: #1a1a1a; color: var(--bs-orange); border: 1px solid #333; border-radius: 8px; font-weight: bold; padding: 6px 12px; transition: all 0.3s ease; text-decoration: none;" onmouseover="this.style.borderColor='var(--bs-orange)'; this.style.boxShadow='0 0 8px rgba(253, 126, 20, 0.3)';" onmouseout="this.style.borderColor='#333'; this.style.boxShadow='none';">
                    + 🛒
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card-fav-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        border: 1px solid #444;
        color: #fff;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
        outline: none;
    }

        .card-fav-btn:hover {
            transform: scale(1.15);
            border-color: #ff4d4d;
            color: #ff4d4d;
            background: rgba(0, 0, 0, 0.9);
        }

        .card-fav-btn.active {
            color: #ff4d4d !important;
            border-color: #ff4d4d;
            background: rgba(255, 77, 77, 0.15);
            box-shadow: 0 0 10px rgba(255, 77, 77, 0.4);
        }

    .product-card:hover {
        border-color: var(--bs-orange) !important;
        box-shadow: 0 12px 25px rgba(0,0,0,0.6), 0 0 15px rgba(253, 126, 20, 0.15) !important;
        transform: translateY(-8px);
    }
</style>
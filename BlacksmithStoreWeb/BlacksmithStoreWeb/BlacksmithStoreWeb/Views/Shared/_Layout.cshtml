    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 10500;">
        <div id="cartToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" style="background-color: var(--bs-orange); color: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-radius: 10px;">
            <div class="d-flex">
                <div class="toast-body" style="font-weight: bold; font-size: 1.1rem;">
                    ✅ <span id="toastMessage">Товар додано до кошика!</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" style="filter: invert(1);"></button>
            </div>
        </div>

        <div id="errorToast" class="toast align-items-center border-0 mt-2" role="alert" aria-live="assertive" aria-atomic="true" style="background-color: #dc3545; color: #fff; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-radius: 10px;">
            <div class="d-flex">
                <div class="toast-body" style="font-weight: bold; font-size: 1.1rem;">
                    ⚠️ <span id="errorToastMessage">Помилка</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>


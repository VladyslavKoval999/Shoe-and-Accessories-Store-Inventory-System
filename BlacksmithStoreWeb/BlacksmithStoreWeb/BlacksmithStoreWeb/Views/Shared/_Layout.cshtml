        <div class="footer-bottom py-4 mt-2">
            <div class="container d-flex justify-content-center align-items-center">
                <span class="copyright text-center">&copy; @DateTime.Now.Year <span style="color: var(--bs-orange); font-weight: bold;">Blacksmith Store</span>. Всі права захищені.</span>

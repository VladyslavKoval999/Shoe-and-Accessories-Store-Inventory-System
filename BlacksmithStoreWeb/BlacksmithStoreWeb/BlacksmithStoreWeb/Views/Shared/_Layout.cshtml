    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const themeCheckbox = document.getElementById('themeCheckbox');
            if (localStorage.getItem("theme") === "dark") {
                document.body.setAttribute("data-theme", "dark");
                themeCheckbox.checked = true;
            } else {
                document.body.removeAttribute("data-theme");
                themeCheckbox.checked = false;
            }

            updateCartBadgeFromServer();

            const cartOffcanvasEl = document.getElementById('cartOffcanvas');
            const aiWidget = document.getElementById('ai-chat-widget');

            if (cartOffcanvasEl && aiWidget) {
                cartOffcanvasEl.addEventListener('show.bs.offcanvas', function () {
                    aiWidget.style.transform = 'translateX(-420px)';
                });

                cartOffcanvasEl.addEventListener('hidden.bs.offcanvas', function () {
                    aiWidget.style.transform = 'translateX(0)';
                });
            }

            const searchInput = document.getElementById('searchInput');
            const searchDropdown = document.getElementById('searchResultsDropdown');
            let debounceTimer;

            if (searchInput && searchDropdown) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    const query = this.value.trim();

                    if (query.length < 2) {
                        searchDropdown.classList.add('d-none');
                        return;
                    }

                    debounceTimer = setTimeout(() => {
                        fetch(`/Home/LiveSearch?query=${encodeURIComponent(query)}`)
                            .then(response => response.json())
                            .then(data => {
                                searchDropdown.innerHTML = '';
                                if (data.length > 0) {
                                    data.forEach(item => {
                                        const itemHtml = `
                                            <a href="/Home/Details/${item.id}" class="dropdown-item d-flex align-items-center py-2 px-3 text-decoration-none" style="border-bottom: 1px solid #333; white-space: normal; color: #fff;">
                                                <img src="${item.image}" alt="${item.name}" style="width: 45px; height: 45px; object-fit: contain; background: #161616; border-radius: 6px; margin-right: 15px; border: 1px solid #333;">
                                                <div style="flex-grow: 1; min-width: 0;">
                                                    <div style="font-size: 0.95rem; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.name}</div>
                                                    <div style="color: var(--bs-orange); font-size: 0.9rem; font-weight: 900;">${item.price} ₴</div>
                                                </div>
                                            </a>
                                        `;
                                        searchDropdown.insertAdjacentHTML('beforeend', itemHtml);
                                    });
                                    searchDropdown.classList.remove('d-none');
                                } else {
                                    searchDropdown.innerHTML = '<div class="p-3 text-center text-muted" style="font-size: 0.9rem;">Товарів не знайдено</div>';
                                    searchDropdown.classList.remove('d-none');
                                }
                            })
                            .catch(err => console.error('Помилка живого пошуку:', err));
                    }, 400);
                });

                document.addEventListener('click', function(e) {
                    if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                        searchDropdown.classList.add('d-none');
                    }
                });

                searchInput.addEventListener('focus', function() {
                    if (this.value.trim().length >= 2 && searchDropdown.innerHTML.trim() !== '') {
                        searchDropdown.classList.remove('d-none');
                    }
                });
            }
        });

        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
                updateCartBadgeFromServer();
            }
        });

        function toggleTheme() {
            const themeCheckbox = document.getElementById('themeCheckbox');
            if (themeCheckbox.checked) {
                document.body.setAttribute("data-theme", "dark");
                localStorage.setItem("theme", "dark");
            } else {
                document.body.removeAttribute("data-theme");
                localStorage.setItem("theme", "light");
            }
        }

        let chatHistory = [];

        function toggleAiChat() {
            const chatWindow = document.getElementById('ai-chat-window');
            if (chatWindow.classList.contains('d-none')) {
                chatWindow.classList.remove('d-none');
                document.getElementById('ai-chat-input').focus();
            } else {
                chatWindow.classList.add('d-none');
            }
        }

        function handleChatEnter(e) {
            if (e.key === 'Enter') sendAiMessage();
        }

        function sendAiMessage() {
            const inputEl = document.getElementById('ai-chat-input');
            const message = inputEl.value.trim();
            if (!message) return;

            chatHistory.push({ role: 'user', text: message });
            addChatMessage(message, 'user');
            inputEl.value = '';

            const messagesContainer = document.getElementById('ai-chat-messages');
            const loadingId = 'loading-' + Date.now();
            const loadingEl = document.createElement('div');
            loadingEl.id = loadingId;
            loadingEl.className = 'chat-loading';
            loadingEl.innerText = 'Асистент друкує...';
            messagesContainer.appendChild(loadingEl);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            fetch('/AIChat/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ history: chatHistory })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById(loadingId).remove();
                if (data.success && !data.reply.includes("⚠️ Помилка API Google")) {
                    chatHistory.push({ role: 'model', text: data.reply });
                }
                addChatMessage(data.reply, 'bot');
            })
            .catch(error => {
                document.getElementById(loadingId).remove();
                addChatMessage("Мережева помилка. Сервер не відповідає.", 'bot');
            });
        }

        function addChatMessage(text, sender) {
            const container = document.getElementById('ai-chat-messages');
            const msgEl = document.createElement('div');
            msgEl.className = `chat-message ${sender}`;

            if (sender === 'bot') {
                let htmlText = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/^\* /gm, '• ')
                    .replace(/\n/g, '<br>');
                msgEl.innerHTML = htmlText;
            } else {
                msgEl.innerText = text;
            }

            container.appendChild(msgEl);
            container.scrollTop = container.scrollHeight;
        }

        function toggleFavorite(productId) {
            fetch(`/Home/ToggleFavorite?id=${productId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if(window.location.pathname.includes("Favorites")) {
                        location.reload();
                    } else {
                        const buttons = document.querySelectorAll(`.card-fav-btn[data-id="${productId}"]`);
                        buttons.forEach(btn => {
                            if (data.isAdded) {
                                btn.classList.add('active');
                                btn.style.color = 'red';
                            } else {
                                btn.classList.remove('active');
                                btn.style.color = '#fff';
                            }
                        });
                        document.getElementById('toastMessage').innerText = data.isAdded ? "Товар додано до вподобань! ❤️" : "Товар видалено з вподобань! 🖤";
                        new bootstrap.Toast(document.getElementById('cartToast'), { delay: 2500 }).show();
                    }
                }
            })
        }

        function updateCartBadgeFromServer() {
            fetch('/Cart/GetCartCount?_t=' + new Date().getTime(), { cache: 'no-store' })
            .then(res => res.json())
            .then(data => {
                updateCartBadge(data.count);
            })
            .catch(err => console.log('Помилка завантаження лічильника кошика:', err));
        }

        function updateCartBadge(count) {
            const badge = document.getElementById('cart-count-badge');
            if(badge) {
                if(count > 0) {
                    badge.innerText = count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
        }

        function updateCartQuantity(productId, size, delta) {
            fetch(`/Cart/UpdateQuantity`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: productId, size: size, delta: delta })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(data.cartCount);
                    openCart();
                } else {
                    document.getElementById('errorToastMessage').innerText = data.message || "Помилка.";
                    new bootstrap.Toast(document.getElementById('errorToast'), { delay: 4000 }).show();
                }
            });
        }

        function clearCart() {
            fetch('/Cart/ClearAjax', { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(0);
                    openCart();
                    document.getElementById('toastMessage').innerText = "Кошик повністю очищено!";
                    new bootstrap.Toast(document.getElementById('cartToast'), { delay: 2500 }).show();
                }
            });
        }

        function addToCart(productId, size = null, quantity = 1) {
            fetch(`/Cart/AddToCart`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: productId, size: size, quantity: quantity })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    let msg = `"${data.productName}"`;
                    if(size) msg += ` (Розмір: ${size})`;
                    document.getElementById('toastMessage').innerText = `${msg} успішно додано!`;
                    new bootstrap.Toast(document.getElementById('cartToast'), { delay: 3000 }).show();

                    updateCartBadge(data.cartCount);
                    if(document.getElementById('cartOffcanvas').classList.contains('show')) openCart();
                } else {
                    document.getElementById('errorToastMessage').innerText = data.message || "Помилка при додаванні.";
                    new bootstrap.Toast(document.getElementById('errorToast'), { delay: 4000 }).show();
                    if(document.getElementById('cartOffcanvas').classList.contains('show')) openCart();
                }
            });
        }

        function openCart() {
            fetch('/Cart/GetCartPartial')
            .then(res => res.text())
            .then(html => {
                const offcanvasEl = document.getElementById('cartOffcanvas');
                offcanvasEl.innerHTML = html;
                const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl) || new bootstrap.Offcanvas(offcanvasEl);
                bsOffcanvas.show();
            });
        }

        function removeFromCart(productId, size) {
            fetch(`/Cart/RemoveFromCart?id=${productId}&size=${size || ''}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(data.cartCount);
                    openCart();
                }
            });
        }
    </script>
</body>
</html>
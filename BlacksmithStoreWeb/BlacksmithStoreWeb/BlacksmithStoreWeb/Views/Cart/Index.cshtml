@model List<BlacksmithStoreWeb.Models.CartItem>
@inject BlacksmithStoreWeb.Data.StoreContext DbContext

@{
    ViewData["Title"] = "Мій Кошик";
}

<div class="offcanvas-header" style="border-bottom: 1px solid #333;">
    <h5 class="offcanvas-title d-flex align-items-center" id="cartOffcanvasLabel" style="color: var(--bs-orange); font-weight: 900; text-transform: uppercase;">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-cart3 me-2" viewBox="0 0 16 16">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
        </svg>
        Мій Кошик
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close" style="filter: invert(1);"></button>
</div>

<div class="offcanvas-body d-flex flex-column" style="background-color: var(--bs-black);">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-light mt-5 flex-grow-1 d-flex flex-column justify-content-center align-items-center">
            <div style="font-size: 4rem; opacity: 0.3; margin-bottom: 20px;">🛍️</div>
            <h4 style="color: #888; font-weight: bold;">Твій кошик порожній</h4>
            <p style="color: #555; font-size: 0.9rem;">Додай товари з каталогу, щоб оформити замовлення.</p>
            <button type="button" class="btn fw-bold mt-4 px-4 py-2 rounded-pill" data-bs-dismiss="offcanvas" style="background-color: transparent; border: 2px solid var(--bs-orange); color: var(--bs-orange); transition: 0.3s;" onmouseover="this.style.backgroundColor='var(--bs-orange)'; this.style.color='#000';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--bs-orange)';">
                Продовжити покупки
            </button>
        </div>
    }
    else
    {
        <div class="cart-items flex-grow-1 overflow-auto pe-2" style="scrollbar-width: thin; scrollbar-color: #444 var(--bs-black);">
            @foreach (var item in Model)
            {
                int availableStock = 0;
                var sizeRecord = DbContext.Sizes.FirstOrDefault(s => s.Value == item.Size);
                var stockList = DbContext.Stocks.Where(s => s.ProductId == item.ProductId).ToList();
                var stockRecord = sizeRecord != null
                ? stockList.FirstOrDefault(s => s.SizeId == sizeRecord.SizeId)
                : stockList.FirstOrDefault();

                if (stockRecord != null)
                {
                    availableStock = stockRecord.Quantity;
                }

                bool isOverStock = item.Quantity > availableStock;
                string bgStyle = isOverStock ? "background-color: rgba(220, 53, 69, 0.15); border: 1px solid #dc3545; border-radius: 8px; padding: 10px;" : "border-bottom: 1px solid #222; padding-bottom: 15px;";

                string imageUrl = "/Images/placeholder.jpg";
                if (!string.IsNullOrEmpty(item.Image))
                {
                    var firstImageStr = item.Image.Split(',')[0].Trim();
                    var fileName = System.IO.Path.GetFileName(firstImageStr);
                    imageUrl = $"/Images/Product/{fileName}";
                }

                <div class="mb-3 @(isOverStock ? "mt-2" : "")" style="@bgStyle">
                    <div class="d-flex align-items-center">
                        <img src="@imageUrl" alt="@item.Name" style="width: 70px; height: 70px; object-fit: contain; background: #161616; border: 1px solid #333; border-radius: 8px; margin-right: 15px;" onerror="this.src='/Images/placeholder.jpg';" />

                        <div class="flex-grow-1">
                            <h6 class="text-light mb-1" style="font-size: 0.95rem; font-weight: 600; line-height: 1.2;">
                                @item.Name
                            </h6>
                            @if (!string.IsNullOrEmpty(item.Size))
                            {
                                <span class="badge mt-1 mb-2" style="background-color: #2a2a2a; border: 1px solid #444; color: #ccc; font-size: 0.75rem;">Розмір: @item.Size</span>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span style="color: var(--bs-orange); font-weight: bold; font-size: 1.1rem; min-width: 60px;">
                                    @item.Price.ToString("0") ₴
                                </span>

                                <div class="d-flex align-items-center" style="background-color: #222; border-radius: 6px; border: 1px solid #444;">
                                    <button onclick="updateCartQuantity(@item.ProductId, '@(item.Size ?? "")', -1)" class="btn btn-sm text-light px-2" style="border: none;">−</button>
                                    <span class="text-light fw-bold px-2" style="font-size: 0.9rem;">
                                        @(isOverStock? availableStock : item.Quantity)
                                    </span>
                                    <button onclick="updateCartQuantity(@item.ProductId, '@(item.Size ?? "")', 1)" class="btn btn-sm text-light px-2" style="border: none;" @(isOverStock ? "disabled" : "")>+</button>
                                </div>

                                <button onclick="removeFromCart(@item.ProductId, '@(item.Size ?? "")')" class="btn btn-outline-danger p-0 d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px; border-width: 1px; transition: all 0.2s;" title="Видалити">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" />
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3h11V2h-11v1Z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    @if (isOverStock)
                    {
                        <div style="color: #ff5252; font-size: 0.8rem; font-weight: bold; text-align: center; margin-top: 8px;">
                            На складі залишилось лише @availableStock шт.
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-4 pt-3" style="border-top: 2px solid var(--bs-orange);">
            <div class="d-flex justify-content-between text-light mb-4" style="font-size: 1.3rem; font-weight: 900;">
                <span>Разом:</span>
                <span style="color: var(--bs-orange);">@Model.Sum(x => x.TotalPrice).ToString("0") ₴</span>
            </div>

            <div class="d-flex gap-2">
                <button type="button" onclick="clearCart()" class="btn btn-outline-secondary w-50 fw-bold d-flex justify-content-center align-items-center" style="border-radius: 8px; color: #ccc;">
                    Очистити
                </button>
                <a asp-controller="Order" asp-action="Checkout" class="btn w-50 fw-bold text-center" style="background-color: var(--bs-orange); color: #fff; text-shadow: 0px 1px 3px rgba(0,0,0,0.5); border-radius: 8px; padding: 12px; text-transform: uppercase; text-decoration: none; transition: 0.3s;" onmouseover="this.style.backgroundColor='#e67e22'" onmouseout="this.style.backgroundColor='var(--bs-orange)'">
                    Оформити
                </a>
            </div>
        </div>
    }
</div>
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const toggleButtons = document.querySelectorAll(".toggle-password");

            toggleButtons.forEach(button => {

                const targetId = button.getAttribute("data-target");
                const input = document.getElementById(targetId);
                const bgColor = window.getComputedStyle(input).backgroundColor;
                const rgb = bgColor.match(/\d+/g);
                let isDarkBg = true;

                if (rgb && rgb.length >= 3) {
                    const r = parseInt(rgb[0]);
                    const g = parseInt(rgb[1]);
                    const b = parseInt(rgb[2]);
                    const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                    isDarkBg = brightness < 128;
                }

                if (isDarkBg) {
                    button.style.color = "rgba(255, 255, 255, 0.5)";
                    button.dataset.hoverColor = "rgba(255, 255, 255, 1)";
                } else {
                    button.style.color = "rgba(0, 0, 0, 0.5)";
                    button.dataset.hoverColor = "rgba(0, 0, 0, 1)";
                }

                const defaultColor = button.style.color;

                button.addEventListener("mouseenter", function () {
                    this.style.color = this.dataset.hoverColor;
                });
                button.addEventListener("mouseleave", function () {
                    this.style.color = defaultColor;
                });

                button.addEventListener("click", function () {
                    if (input.type === "password") {
                        input.type = "text";
                        this.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>`;
                    } else {
                        input.type = "password";
                        this.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16"><path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/><path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/></svg>`;
                    }
                });
            });

            const phoneInput = document.getElementById("ProfilePhoneNumber");
            if (phoneInput) {
                let initialVal = phoneInput.value;
                if (initialVal && initialVal.trim() !== "") {
                    let digits = initialVal.replace(/\D/g, '');
                    if (digits.startsWith("380")) digits = digits.substring(3);
                    else if (digits.startsWith("0")) digits = digits.substring(1);

                    let formatted = "+380";
                    if (digits.length > 0) formatted += " " + digits.substring(0, 2);
                    if (digits.length > 2) formatted += " " + digits.substring(2, 5);
                    if (digits.length > 5) formatted += " " + digits.substring(5, 7);
                    if (digits.length > 7) formatted += " " + digits.substring(7, 9);
                    phoneInput.value = formatted;
                } else {
                    phoneInput.value = "+380 ";
                }

                phoneInput.addEventListener("focus", function () {
                    if (this.value.trim() === "" || this.value.trim() === "+380") {
                        this.value = "+380 ";
                    }
                });

                phoneInput.addEventListener("input", function (e) {
                    let val = this.value;

                    if (!val.startsWith("+380")) {
                        let digits = val.replace(/\D/g, '');
                        if (digits.startsWith("380")) {
                            digits = digits.substring(3);
                        } else if (digits.startsWith("0")) {
                            digits = digits.substring(1);
                        }
                        this.value = "+380 " + digits;
                        val = this.value;
                    }

                    let digits = val.substring(4).replace(/\D/g, '');
                    let formatted = "+380";
                    if (digits.length > 0) formatted += " " + digits.substring(0, 2);
                    if (digits.length > 2) formatted += " " + digits.substring(2, 5);
                    if (digits.length > 5) formatted += " " + digits.substring(5, 7);
                    if (digits.length > 7) formatted += " " + digits.substring(7, 9);

                    this.value = formatted;
                });

                phoneInput.addEventListener("keydown", function (e) {
                    if (e.key === "Backspace" || e.key === "Delete") {
                        if (this.selectionStart <= 5 && this.selectionEnd <= 5) {
                            e.preventDefault();
                        }
                    }
                });
            }
        });
    </script>
}
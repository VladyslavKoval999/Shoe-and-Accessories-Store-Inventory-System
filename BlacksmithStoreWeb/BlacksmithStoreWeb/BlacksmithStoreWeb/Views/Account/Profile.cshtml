@model BlacksmithStoreWeb.Models.ProfileViewModel
@{
    ViewData["Title"] = "Особистий кабінет";
}

<div class="premium-page-hero text-center mb-5">
    <div class="hero-bg-glow" style="background: radial-gradient(circle, rgba(253, 126, 20, 0.1) 0%, transparent 70%);"></div>
    <div class="container position-relative" style="z-index: 2;">
        <h1 class="premium-hero-title">ОСОБИСТИЙ КАБІНЕТ</h1>
        <p class="premium-hero-subtitle">Керуйте своїми даними, відстежуйте бонуси та налаштування.</p>
    </div>
</div>

<div class="container mt-5 mb-5 slide-up" style="min-height: 70vh;">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background-color: #153015; border: 1px solid #28a745; color: #4caf50; border-radius: 12px;">
            <strong>Успішно!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1);"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background-color: #301515; border: 1px solid #dc3545; color: #ff5252; border-radius: 12px;">
            <strong>Помилка!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1);"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="premium-panel p-4 mb-4" style="background-color: var(--bs-black); border-radius: 16px; border: 1px solid #252525;">
                <div class="text-center mb-4">
                    <div style="width: 80px; height: 80px; background-color: #161616; border: 2px solid var(--bs-orange); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; font-size: 2rem; font-weight: bold; color: var(--bs-orange); box-shadow: 0 0 15px rgba(253, 126, 20, 0.2);">
                        @Model.Username.Substring(0, 1).ToUpper()
                    </div>
                    <h4 class="text-light mb-1" style="font-weight: 800;">@Model.FullName</h4>
                    <div style="color: #ccc; font-size: 1rem; font-weight: 600; margin-bottom: 2px;">@Model.Username</div>
                    <div style="color: #777; font-size: 0.85rem;">@Model.Email</div>
                </div>

                <hr style="border-color: #333; margin: 20px 0;" />

                <h6 style="color: var(--bs-orange); font-weight: 900; margin-bottom: 15px; letter-spacing: 1px;">BLACKSMITH CLUB</h6>

                <div class="mb-4">
                    <small class="text-muted d-block mb-2 text-center">Клікніть, щоб перевернути</small>

                    <div class="flip-card-container" onclick="this.classList.toggle('flipped')">
                        <div class="flip-card-inner">

                            <div class="flip-card-front">
                                <div class="card-bg-overlay"></div>
                                <div class="card-content">
                                    <div class="d-flex justify-content-end align-items-start mb-3">
                                        <div class="card-brand-logo">BLACKSMITH STORE</div>
                                    </div>

                                    <div class="card-number-display">@Model.LoyaltyCardNumber</div>

                                    <div class="d-flex justify-content-between align-items-end mt-auto">
                                        <div class="card-owner-name">@Model.FullName</div>
                                        <div class="card-status-badge">CLUB CARD</div>
                                    </div>
                                </div>
                            </div>

                            <div class="flip-card-back">
                                <div class="back-content d-flex flex-column align-items-center justify-content-center p-3 text-center h-100">
                                    <div class="qr-container mb-3">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=@Model.LoyaltyCardNumber" alt="QR Code" class="qr-code-img" />
                                    </div>
                                    <div class="back-text w-100">
                                        <p class="mb-1" style="font-size: 0.7rem; color: #666; text-transform: uppercase; letter-spacing: 1px;">Security verified</p>
                                        <div class="decorative-lines mb-2">
                                            <span></span><span></span><span></span>
                                        </div>
                                        <p class="mb-0 fw-bold" style="color: var(--bs-orange); letter-spacing: 2px; font-size: 0.8rem; text-transform: uppercase;">Blacksmith Club Member</p>
                                        <p class="mt-1" style="font-size: 0.6rem; color: #444;">Non-transferable | З @Model.CardCreationDate.Year</p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Куплено товарів:</span>
                    <span class="text-light fw-bold" style="font-size: 1.1rem;">@Model.PurchasedItemsCount</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Доступні знижки (-15%):</span>
                    <span style="color: var(--bs-orange); font-weight: 900; font-size: 1.2rem;">@Model.AvailableBonuses од.</span>
                </div>

                <div class="progress-section p-3" style="background-color: #161616; border-radius: 12px; border: 1px solid #222;">
                    <div class="d-flex justify-content-between mb-2">
                        <small class="text-muted">До наступного бонусу:</small>
                        <small style="color: var(--bs-orange); font-weight: bold;">@Model.ProgressPercentage%</small>
                    </div>
                    <div class="progress mb-2" style="height: 8px; background-color: #222; border-radius: 4px; overflow: hidden; border: 1px solid #333;">
                        <div class="progress-bar" role="progressbar" style="width: @Model.ProgressPercentage%; background: linear-gradient(90deg, #ff9800 0%, var(--bs-orange) 100%); box-shadow: 0 0 10px rgba(253, 126, 20, 0.5);" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted d-block text-center mt-2">Залишилось придбати товарів: <strong class="text-light">@Model.ItemsToNextBonus</strong></small>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="premium-panel p-4 h-100" style="background-color: #111; border-radius: 16px; border: 1px solid #252525; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">

                <ul class="nav nav-tabs profile-tabs mb-4" id="profileTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">Мої замовлення</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">Особисті дані</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">Безпека</button>
                    </li>
                </ul>

                <div class="tab-content" id="profileTabsContent">

                    <div class="tab-pane fade show active" id="orders" role="tabpanel">
                        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                        {
                            <div class="orders-list">
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <div class="order-card mb-4 slide-up">
                                        <div class="order-header p-3 d-flex flex-wrap justify-content-between align-items-center">
                                            <div class="mb-2 mb-md-0">
                                                <h5 class="mb-1" style="color: #fff; font-weight: 900; letter-spacing: 1px;">ЗАМОВЛЕННЯ #@order.OrderId</h5>
                                                <span style="color: #888; font-size: 0.9rem;">
                                                    📅 @order.OrderDate.ToString("dd.MM.yyyy HH:mm") &nbsp;•&nbsp; 🛍️ @order.TotalItemsCount товар(ів)
                                                </span>
                                            </div>
                                            <div class="text-md-end text-start">
                                                <h5 style="color: var(--bs-orange); font-weight: 900; margin-bottom: 8px; font-size: 1.4rem;">@order.TotalAmount.ToString("0.00") ₴</h5>

                                                <span class="order-status-text" style="font-weight: 600; color: #ddd;">
                                                    @order.Status
                                                </span>
                                            </div>
                                        </div>

                                        <div class="order-body p-4" style="background-color: #161616;">
                                            @foreach (var item in order.Items)
                                            {
                                                bool isItemReturned = item.Quantity <= 0;
                                                string itemStyle = isItemReturned ? "opacity: 0.5; filter: grayscale(80%);" : "";

                                                <div class="d-flex align-items-center mb-3 pb-3" style="border-bottom: 1px solid #222; @itemStyle">
                                                    <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/Images/placeholder.jpg" : $"/Images/Product/{System.IO.Path.GetFileName(item.ProductImage)}")"
                                                         alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: contain; background: transparent; border-radius: 8px; margin-right: 20px; border: 1px solid #333;" onerror="this.onerror=null; this.src='/Images/placeholder.jpg';" />

                                                    <div class="flex-grow-1">
                                                        <h6 style="color: #fff; margin-bottom: 5px; font-weight: 700; font-size: 1.05rem;">
                                                            @item.ProductName
                                                        </h6>
                                                        <div style="color: #aaa; font-size: 0.9rem;">
                                                            @if (!string.IsNullOrEmpty(item.Size))
                                                            {
                                                                <span class="me-3">Розмір: <strong style="color:#ddd;">@item.Size</strong></span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(item.Color))
                                                            {
                                                                <span>Колір: <strong style="color:#ddd;">@item.Color</strong></span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="text-end ms-3">
                                                        @if (isItemReturned)
                                                        {
                                                            <div style="color: #888; font-size: 0.95rem; margin-bottom: 3px; text-decoration: line-through;">
                                                                1 од. <span style="font-size: 0.8rem;">x</span> @item.Price.ToString("0") ₴
                                                            </div>
                                                            <div style="color: #dc3545; font-weight: 900; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px;">
                                                                @(order.Status == "Очікує збору" || order.Status == "Скасовано" ? "Скасовано" : "Повернуто")
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div style="color: #888; font-size: 0.95rem; margin-bottom: 3px;">
                                                                @item.Quantity од. <span style="font-size: 0.8rem;">x</span> @item.Price.ToString("0") ₴
                                                            </div>
                                                            <div style="color: var(--text-light); font-weight: 900; font-size: 1.1rem;">
                                                                @((item.Quantity * item.Price).ToString("0.00")) ₴
                                                            </div>

                                                            @if (order.Status == "Очікує збору")
                                                            {
                                                                <form asp-controller="Account" asp-action="CancelOrderItem" method="post" class="mt-2" onsubmit="return confirm('Ви дійсно бажаєте скасувати цей товар? Вартість замовлення буде перераховано, а товар повернеться на склад.');">
                                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                                    <input type="hidden" name="productName" value="@item.ProductName" />
                                                                    <input type="hidden" name="size" value="@item.Size" />
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.75rem; border-radius: 6px; border-width: 1px;">
                                                                        ✖ Скасувати товар
                                                                    </button>
                                                                </form>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="order-footer p-3 d-flex flex-wrap justify-content-between align-items-center" style="background-color: #0a0a0a; border-top: 1px solid #282828;">
                                            <div style="color: #999; font-size: 0.9rem; max-width: 70%; margin-bottom: 10px;">
                                                <div class="mb-1"><span style="font-size: 1.2rem; color: var(--bs-orange);">📍</span> <strong>Доставка:</strong> @(order.DeliveryAddress ?? "Магазин (Самовивіз)")</div>
                                                <div class="mb-1"><span style="font-size: 1.2rem; color: var(--bs-orange);">💳</span> <strong>Оплата:</strong> @order.PaymentMethod</div>
                                                @if (!string.IsNullOrEmpty(order.Comment))
                                                {
                                                    <div><span style="font-size: 1.2rem; color: var(--bs-orange);">💬</span> <strong>Коментар:</strong> @order.Comment</div>
                                                }
                                            </div>

                                            @if (order.Status == "Очікує збору")
                                            {
                                                <form asp-controller="Account" asp-action="CancelOrder" method="post" onsubmit="return confirm('Ви дійсно бажаєте скасувати ВСЕ замовлення? Цю дію неможливо буде відмінити.');">
                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                    <button type="submit" class="btn btn-outline-danger" style="font-weight: bold; border-radius: 8px; padding: 8px 20px; transition: all 0.3s;">
                                                        ✖ Скасувати замовлення
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div style="font-size: 4rem; opacity: 0.3; margin-bottom: 20px;">📦</div>
                                <h4 class="text-light fw-bold mb-3">У вас ще немає замовлень</h4>
                                <p style="color: #888; margin-bottom: 30px;">Час вибрати щось стильне у нашому каталозі!</p>
                                <a asp-controller="Home" asp-action="Catalog" class="btn px-5 py-3" style="background-color: var(--bs-orange); color: #000; font-weight: 800; border-radius: 8px;">ПЕРЕЙТИ ДО КАТАЛОГУ</a>
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="settings" role="tabpanel">
                        <form asp-action="UpdateProfile" method="post">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="premium-label mb-2">Електронна пошта</label>
                                        <input type="email" name="Email" value="@Model.Email" class="premium-input" placeholder="Введіть email" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="premium-label mb-2">Номер телефону</label>
                                        <input type="text" id="ProfilePhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" class="premium-input" placeholder="+380..." />
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4 text-end">
                                <button type="submit" class="btn px-5 py-2" style="background-color: #222; color: var(--bs-orange); border: 1px solid var(--bs-orange); font-weight: bold; border-radius: 8px; transition: all 0.3s;" onmouseover="this.style.backgroundColor='var(--bs-orange)'; this.style.color='#000';" onmouseout="this.style.backgroundColor='#222'; this.style.color='var(--bs-orange)';">Зберегти зміни</button>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="security" role="tabpanel">
                        <form asp-action="ChangePassword" method="post" style="max-width: 500px;">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-sm fw-bold"></div>

                            <div class="mb-3">
                                <label class="premium-label mb-2">Поточний пароль</label>
                                <div class="position-relative">
                                    <input asp-for="ChangePassword.OldPassword" id="OldPassword" type="password" class="premium-input pe-5" placeholder="Введіть старий пароль" />
                                    <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" data-target="OldPassword">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
                                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486z" />
                                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829" />
                                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" />
                                        </svg>
                                    </span>
                                </div>
                                <span asp-validation-for="ChangePassword.OldPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                            </div>

                            <div class="mb-3">
                                <label class="premium-label mb-2">Новий пароль</label>
                                <div class="position-relative">
                                    <input asp-for="ChangePassword.NewPassword" id="NewPassword" type="password" class="premium-input pe-5" placeholder="Мінімум 6 символів" />
                                    <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" data-target="NewPassword">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
                                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486z" />
                                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829" />
                                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" />
                                        </svg>
                                    </span>
                                </div>
                                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                            </div>

                            <div class="mb-4">
                                <label class="premium-label mb-2">Підтвердження пароля</label>
                                <div class="position-relative">
                                    <input asp-for="ChangePassword.ConfirmNewPassword" id="ConfirmNewPassword" type="password" class="premium-input pe-5" placeholder="Повторіть новий пароль" />
                                    <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" data-target="ConfirmNewPassword">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
                                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486z" />
                                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829" />
                                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" />
                                        </svg>
                                    </span>
                                </div>
                                <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger" style="font-size: 0.85rem;"></span>
                            </div>

                            <button type="submit" class="btn w-100 py-3" style="background-color: var(--bs-orange); color: #000; font-weight: 800; border-radius: 8px; letter-spacing: 1px;">ЗМІНИТИ ПАРОЛЬ</button>
                        </form>

                        <div class="mt-5 pt-4 border-top text-end" style="border-color: #222 !important;">
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger px-4 py-2" style="border-radius: 8px; font-weight: bold;">
                                Вийти з акаунта
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .slide-up {
        animation: slideUpFade 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
    }

    @@keyframes slideUpFade {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .premium-page-hero {
        background: linear-gradient(135deg, #0a0a0a 0%, #151515 100%);
        padding: 70px 20px;
        position: relative;
        overflow: hidden;
        border-bottom: 2px solid var(--bs-orange);
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }

    .hero-bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60%;
        height: 60%;
        pointer-events: none;
    }

    .premium-hero-title {
        color: #fff;
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
        text-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .premium-hero-subtitle {
